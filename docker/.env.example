# ============================================================
# Docker 部署环境变量配置
# ============================================================
# 首次使用请复制此文件为 .env 并修改其中的配置：
#   cp .env.example .env  （Linux/Mac）
#   或 copy .env.example .env  （Windows）
# ============================================================

# ---------- MySQL 配置 ----------
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# ---------- 后端应用数据源配置 ----------
DB_HOST=172.17.0.1
DB_PORT=3306
DB_USER=root
DB_PWD=your_db_password
DB_NAME=continew_admin

# ---------- Redis 配置 ----------
REDIS_HOST=172.17.0.1
REDIS_PORT=6379
REDIS_PWD=your_redis_password
REDIS_DB=0

# ---------- 任务调度（SnailJob）配置 ----------
SCHEDULE_HOST=172.17.0.1
SCHEDULE_PORT=1788
SCHEDULE_TOKEN=your_schedule_token
SCHEDULE_DB_NAME=continew_admin_job
